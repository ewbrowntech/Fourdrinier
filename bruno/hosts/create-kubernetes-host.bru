meta {
  name: Create Kubernetes host
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/hosts
  body: json
  auth: none
}

script:pre-request {
  const apiUrl = bru.getEnvVar("k8sApiUrl") || "";
  const caCert = (bru.getEnvVar("k8sCaCert") || "")
    .replace(/\\r\\n/g, "\n")
    .replace(/\\n/g, "\n")
    .trim();
  const token = bru.getEnvVar("k8sToken") || "";

  if (!apiUrl.startsWith("https://")) {
    throw new Error("K8S_API_URL is missing or must start with https://");
  }
  if (!caCert.includes("-----BEGIN CERTIFICATE-----")) {
    throw new Error("K8S_CA_CERT is missing or invalid");
  }
  if (token.split(".").length !== 3) {
    throw new Error("K8S_TOKEN is missing or is not a complete JWT");
  }

  req.setBody({
    type: "kubernetes",
    name: "k3s-local",
    api_url: apiUrl,
    ca_cert_pem: caCert,
    token,
    namespace: "fourdrinier",
    enabled: true,
    labels: {
      env: "local"
    }
  });
}

body:json {
  {}
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("kubernetesHostId", res.body.id);
  }
}

tests {
  test("should create kubernetes host", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.have.property("id");
    expect(res.body.type).to.equal("kubernetes");
    expect(res.body.namespace).to.equal("fourdrinier");
  });

  test("should not expose the token or CA", function() {
    expect(res.body).to.not.have.property("token");
    expect(res.body).to.not.have.property("token_encrypted");
    expect(res.body).to.not.have.property("ca_cert_pem");
  });
}
