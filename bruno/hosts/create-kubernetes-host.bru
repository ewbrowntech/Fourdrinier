meta {
  name: Create Kubernetes host
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/hosts
  body: json
  auth: none
}

body:json {
  {
    "name": "local-k8s",
    "kind": "kubernetes",
    "enabled": true,
    "connection": {
      "api_server": "https://127.0.0.1:6443",
      "context": "default",
      "namespace_default": "default"
    },
    "labels": {
      "env": "local"
    }
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("hostId", res.body.id);
  }
}

tests {
  test("should create kubernetes host", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.have.property("id");
    expect(res.body.kind).to.equal("kubernetes");
    expect(res.body.name).to.equal("local-k8s");
  });
}
