meta {
  name: Get Docker host
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/hosts/{{dockerHostId}}
  body: none
  auth: none
}

params:path {
  dockerHostId: {{dockerHostId}}
}

tests {
  test("should get docker host by id", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id");
    expect(res.body.id).to.equal(bru.getEnvVar("dockerHostId"));
  });
}
