meta {
  name: Create Docker host
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/hosts
  body: json
  auth: none
}

body:json {
  {
    "name": "remote-docker",
    "address": "host.docker.internal",
    "port": 22,
    "username": "{{username}}",
    "keypair_id": "{{keypairId}}",
    "enabled": true,
    "labels": {
      "env": "local"
    }
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("dockerHostId", res.body.id);
  }
}

tests {
  test("should create docker host", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.have.property("id");
    expect(res.body.name).to.equal("remote-docker");
    expect(res.body.host_key_fingerprint).to.equal(null);
  });
}
