meta {
  name: Get host
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/hosts/{{hostId}}
  body: none
  auth: none
}

params:path {
  hostId: {{hostId}}
}

tests {
  test("should get host by id", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.have.property("id");
    expect(res.body.id).to.equal(bru.getEnvVar("hostId"));
  });
}
