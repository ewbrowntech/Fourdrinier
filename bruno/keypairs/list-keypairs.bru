meta {
  name: List keypairs
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/api/v1/keypairs
  body: none
  auth: none
}

script:post-response {
  if (res.status === 200 && Array.isArray(res.body) && res.body.length === 1 && res.body[0].id) {
    bru.setEnvVar("keypairId", res.body[0].id);
  }
}

tests {
  test("should list keypairs", function() {
    expect(res.status).to.equal(200);
    expect(res.body).to.be.an("array");
  });
}
