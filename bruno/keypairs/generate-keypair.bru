meta {
  name: Generate keypair
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/keypairs
  body: json
  auth: none
}

body:json {
  {
    "name": "default"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.id) {
    bru.setEnvVar("keypairId", res.body.id);
  }
}

tests {
  test("should generate keypair", function() {
    expect(res.status).to.equal(201);
    expect(res.body).to.have.property("id");
    expect(res.body.source).to.equal("generated");
    expect(res.body.public_key).to.be.a("string");
    expect(res.body).to.not.have.property("private_key");
    expect(res.body).to.not.have.property("private_key_encrypted");
  });
}
