meta {
  name: 4. Start Server
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/servers/{{serverId}}/start
  body: none
  auth: none
}

docs {
  # Start Server

  Starts the Minecraft server by creating a Kubernetes Pod with all necessary resources.

  This operation:
  1. Creates a PersistentVolumeClaim for server data
  2. Deploys a Kubernetes Pod running the Minecraft server
  3. Creates a Service to expose the server

  ## Path Parameters

  - `server_id`: The UUID of the server to start

  ## Response

  Returns information about the created Kubernetes Pod:

  ```json
  {
    "pod": {
      "name": "minecraft-server-xyz",
      "namespace": "minecraft"
    }
  }
  ```

  ## Error Responses

  - `404`: Server not found

  ## Notes

  The server may take a few minutes to fully start up as it downloads
  necessary files and initializes the world.
}

assert {
  res.status: eq 201
}
