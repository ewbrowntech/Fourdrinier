meta {
  name: 3. Get Server
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/servers/{{serverId}}
  body: none
  auth: none
}

docs {
  # Get Server by ID

  Retrieves details of a specific server by its ID.

  ## Path Parameters

  - `server_id`: The UUID of the server

  ## Response

  Returns a server object containing:
  - `id`: Server UUID
  - `name`: Server name
  - `loader`: Server loader type
  - `game_version`: Minecraft version

  ## Error Responses

  - `404`: Server not found
}

assert {
  res.status: eq 200
}
