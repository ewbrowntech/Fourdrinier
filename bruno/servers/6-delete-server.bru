meta {
  name: 6. Delete Server
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/servers/{{serverId}}
  body: none
  auth: none
}

docs {
  # Delete Server

  Permanently deletes a server and all its associated Kubernetes resources.

  This operation:
  1. Deletes the Kubernetes Pod
  2. Deletes the PersistentVolumeClaim (ALL SERVER DATA IS LOST)
  3. Deletes the Service
  4. Removes the server record from the database

  ## Path Parameters

  - `server_id`: The UUID of the server to delete

  ## Response

  Returns status code 200 with no content on success.

  ## Error Responses

  - `404`: Server not found

  ## ⚠️ WARNING

  This action is IRREVERSIBLE. All server data including worlds,
  configurations, and player data will be permanently deleted.
}

assert {
  res.status: eq 200
}

script:post-response {
  // Clear the serverId after deletion
  bru.setEnvVar("serverId", "");
}
