meta {
  name: 5. Stop Server
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/servers/{{serverId}}/stop
  body: none
  auth: none
}

docs {
  # Stop Server

  Stops the running Minecraft server by deleting its Kubernetes Pod.

  This operation:
  1. Deletes the Kubernetes Pod
  2. Preserves the PersistentVolumeClaim (server data is kept)
  3. Keeps the Service (can be restarted later)

  ## Path Parameters

  - `server_id`: The UUID of the server to stop

  ## Response

  ```json
  {
    "message": "Server stopped"
  }
  ```

  ## Error Responses

  - `404`: Server not found

  ## Notes

  The server data persists on the PVC, so you can restart the server
  later without losing any progress.
}

assert {
  res.status: eq 200
}
