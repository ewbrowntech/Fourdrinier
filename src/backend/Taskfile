version: "3"

tasks:
  dev:
    desc: Run the API with uvicorn and auto-reload (ENV=debug)
    deps: [sync]
    env:
      ENV: debug
    cmds:
      - uv run python -m fourdrinier.main

  prod:
    desc: Run the API with gunicorn + uvicorn workers
    deps: [sync]
    env:
      ENV: production
    cmds:
      - uv run python -m fourdrinier.main
