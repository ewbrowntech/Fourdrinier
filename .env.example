# Copy to .env at the repo root and adjust for local development.
# Real environment variables override values in this file.

# debug | test | development | production
# Use debug for local work with auto-reload (see fourdrinier.main.debug).
ENV=debug
HOST=0.0.0.0
PORT=8000

LOG_LEVEL=info

# DOCS_URL=/docs
# REDOC_URL=/redoc
# OPENAPI_URL=/openapi.json
# Set to empty to disable (e.g. DOCS_URL= in production).

# WEB_CONCURRENCY=

# GUNICORN_TIMEOUT=120
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100
# GUNICORN_PRELOAD=true
