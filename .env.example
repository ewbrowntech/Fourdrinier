# Copy to .env at the repo root and adjust for local development.
# Real environment variables override values in this file.

# Deployment tier and server mode:
#   debug — uvicorn with auto-reload (local development only)
#   dev   — gunicorn (PR previews, dev cluster, default when unset)
#   stage — gunicorn (pre-production)
#   prod  — gunicorn (production)
#   test  — gunicorn (automated tests / CI)
ENV=debug
HOST=0.0.0.0
PORT=8000

LOG_LEVEL=info

# DOCS_URL=/docs
# REDOC_URL=/redoc
# OPENAPI_URL=/openapi.json
# Set to empty to disable (e.g. DOCS_URL= in prod).

# WEB_CONCURRENCY=

# Async SQLite (default: <repo>/data/fourdrinier.db). Override for tests or custom paths.
# DATABASE_URL=sqlite+aiosqlite:///./data/fourdrinier.db

# Fernet key for encrypting secrets at rest (SSH private keys). Required for
# keypair/host features. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# GUNICORN_TIMEOUT=120
# GUNICORN_GRACEFUL_TIMEOUT=30
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100
# GUNICORN_PRELOAD=true
