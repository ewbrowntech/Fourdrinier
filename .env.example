# # Kubernetes Configuration
# K8S_API_HOST=https://127.0.0.1:6443
# K8S_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token
# K8S_CA_CERT_PATH=/var/run/secrets/kubernetes.io/serviceaccount/ca.crt
# K8S_NAMESPACE=minecraft

# # Database
# DB_URL=sqlite+aiosqlite:///./db-data/fourdrinier.db

# # Minecraft Server Configuration
# MINECRAFT_IMAGE=itzg/minecraft-server:java21-alpine
# MINECRAFT_PVC_SIZE=5Gi
# MINECRAFT_STORAGE_CLASS=local-path
# MINECRAFT_CPU_REQUEST=1000m
# MINECRAFT_CPU_LIMIT=2000m
# MINECRAFT_MEMORY_REQUEST=2Gi
# MINECRAFT_MEMORY_LIMIT=4Gi

# Host Directory Mounting (Development/Debug)
# When set, uses hostPath volumes instead of PVC
# Directories formatted as: {Server Name} ({ID})
# IMPORTANT: Directories are PRESERVED after server deletion
#
# For docker-compose: The path is inside the container (pre-configured to /fd/minecraft-data)
# For local/native: Use absolute path on your host machine
# Example for docker-compose (default): MINECRAFT_HOST_DATA_DIR=/fd/minecraft-data
# Example for local debug: MINECRAFT_HOST_DATA_DIR=/home/ebrown/projects/fourdrinier/tmp
# MINECRAFT_HOST_DATA_DIR=
